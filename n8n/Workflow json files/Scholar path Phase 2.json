    {
      "parameters": {
        "jsCode": "const domainRec = $('Get a row').first().json;\n\n\n// Get the recommendation ID\nconst domainRecommendationId =\n  $('Edit Fields').first().json.domain_recommendation_id ||\n  domainRec.id;\n\nconst results = $json.results || [];\n\nreturn results.map(paper => {\n\n  let abstract = '';\n\n  if (paper.abstract_inverted_index) {\n    const words = [];\n\n    for (const [word, positions] of Object.entries(\n      paper.abstract_inverted_index\n    )) {\n      for (const position of positions) {\n        words[position] = word;\n      }\n    }\n\n    abstract = words.filter(Boolean).join(' ');\n  }\n\n  const authors = (paper.authorships || []).map(author => ({\n    name: author.author?.display_name || ''\n  }));\n\n  return {\n    json: {\n      source: 'openalex',\n      external_id: paper.id || null,\n      title: paper.title || '',\n      abstract: abstract,\n\n      authors: authors,\n\n      venue:\n        paper.primary_location?.source?.display_name || '',\n\n      publication_year:\n        paper.publication_year || null,\n\n      citation_count:\n        paper.cited_by_count ?? null,\n\n      url:\n        paper.primary_location?.landing_page_url ||\n        paper.doi ||\n        paper.id ||\n        null,\n\n      domain:\n        domainRec.domain,\n\n      // MUST be preserved through Loop\n      domain_recommendation_id:\n        domainRecommendationId\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        -96
      ],
      "id": "38460f44-bbc8-44c3-a74a-2161babe302c",
      "name": "Normalize Code Output"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [\n      {\n        \"text\": \"You are helping a prospective grad student quickly evaluate a research paper against their intended research domain.\\n\\nGiven the paper's abstract and the student's target domain, produce:\\n1. A plain-language summary (2-3 sentences, no jargon a non-specialist wouldn't understand — explain what the paper actually did and found).\\n2. A relevance judgment: how well this paper's actual content matches the stated domain — not just keyword overlap.\\n\\nBe honest about weak matches. If the abstract only tangentially relates to the domain, say so and mark relevance \\\"low\\\" — do not inflate relevance to seem more useful.\\n\\nReturn ONLY valid JSON, no markdown fences:\\n\\n{\\n  \\\"plain_summary\\\": \\\"string\\\",\\n  \\\"relevance_confidence\\\": \\\"high | medium | low\\\",\\n  \\\"relevance_reasoning\\\": \\\"string — one sentence on why this confidence level\\\"\\n}\"\n      }\n    ]\n  },\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"TARGET DOMAIN: {{ $json.domain }}\\n\\nPAPER TITLE: {{ $json.title }}\\n\\nABSTRACT: {{ $json.abstract }}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
