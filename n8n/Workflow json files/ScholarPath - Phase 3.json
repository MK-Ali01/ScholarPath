    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `You are evaluating whether a specific scholarship is a good match for this candidate, based on their profile and the scholarship's eligibility rules.\\n\\nYou are NOT authorized to confirm nationality/country eligibility. Always note country eligibility as unverified unless explicitly told the candidate's country was already checked against the list.\\n\\nBe conservative. If eligibility depends on something the profile doesn't state, say so explicitly rather than assuming a favorable answer.\\n\\nReturn ONLY valid JSON, no markdown fences:\\n{\\n  \\\"match_confidence\\\": \\\"high | medium | low\\\",\\n  \\\"match_reasoning\\\": \\\"string\\\",\\n  \\\"unmet_or_unclear_criteria\\\": [\\\"string\\\"]\\n}\\n\\nCANDIDATE PROFILE: ${JSON.stringify($json.structured_profile)}\\nCANDIDATE STATED COUNTRY: ${$json.candidate_country || 'NOT PROVIDED - flag as unverified'}\\nSCHOLARSHIP: ${$json.name}\\nELIGIBILITY SUMMARY: ${$json.eligibility_summary}\\nDEADLINE: ${$json.deadline_text}` }] }] }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        80
      ],
      "id": "699c8f0c-d874-4603-b935-a5ee9e80da11",
      "name": "LLM: Evaluate Scholarship Match",
      "retryOnFail": true,
      "maxTries": 2,
      "credentials": {
        "googlePalmApi": {
          "id": "GmARygcg2M2pbVZ9",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "try {\n  const raw = $input.first().json.candidates[0].content.parts[0].text;\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  return [{ json: { ...parsed, _parse_ok: true } }];\n} catch (err) {\n  return [{ json: { _parse_ok: false, error: err.message } }];\n}"
      },
      "type": "n8n-nodes-base.code",
