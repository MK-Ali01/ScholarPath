    {
      "parameters": {
        "jsCode": "const domainItem = $('Get Domain Recommendation').first();\nconst profileItem = $('Get Profile').first();\nconst domain = (domainItem.json.domain || '').toLowerCase();\nconst scholarships = $input.all().map(i => i.json);\n\nconst matched = scholarships.filter(s => {\n  const tags = s.domain_tags || [];\n  if (tags.includes('all')) return true;\n  return tags.some(tag => domain.includes(String(tag).toLowerCase()) || String(tag).toLowerCase().includes(domain));\n});\n\nreturn matched.map(s => ({\n  json: {\n    ...s,\n    profile_id: profileItem.json.id,\n    candidate_country: profileItem.json.candidate_country,\n    structured_profile: profileItem.json.structured_profile,\n    domain: domainItem.json.domain,\n    domain_recommendation_id: domainItem.json.id\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        80
      ],
      "id": "e93f2f01-1e6b-41fa-86e5-dea362df1772",
